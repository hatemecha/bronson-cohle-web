---
layout: layouts/base.njk
---
<article class="texto">
  <div class="texto-layout">
    <header class="texto-header">
      <div class="texto-meta">
        <span class="meta-id">{{ id }}</span>
        <time class="meta-date" datetime="{{ date | formatDateIso }}">{{ date | formatDateShort }}</time>
      </div>
      <div class="texto-title-block">
        <h1 class="texto-title">{{ title }}</h1>
      </div>
    </header>

    {% set imageData = image | resolveTextoImage(page.fileSlug) %}
    {% if imageData %}
      {% set figureClass = "texto-figure" %}
      {% include "partials/content-figure.njk" %}
    {% endif %}

    <div class="texto-body" data-pagefind-body>
      {{ content | safe }}
    </div>

    <div class="texto-end">
      <div class="texto-share">
        <button type="button" class="text-button share-button" data-share="{{ page.url | absoluteUrl(site.url) }}" aria-describedby="share-status">compartir</button>
        <span id="share-status" class="sr-only" aria-live="polite"></span>
      </div>

      {% set relatedItems = related | resolveRelated(collections) %}
      {% if relatedItems.length %}
      <hr class="rule">
      <section class="related" aria-labelledby="otros-textos">
        <h2 id="otros-textos" class="section-label">Otros textos</h2>
        <ul class="related-list">
          {% for item in relatedItems %}
          <li><a href="{{ item.url | url }}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}

      {% set prev = page | prevTexto(collections) %}
      {% set next = page | nextTexto(collections) %}
      {% if prev or next %}
      <nav class="text-nav" aria-label="Navegación entre textos">
        <span class="text-nav-prev">
          {% if prev %}
          <a href="{{ prev.url | url }}" class="text-nav-link">
            <span class="text-nav-arrow" aria-hidden="true">&larr;</span>
            <span class="text-nav-label">{{ prev.data.title }}</span>
          </a>
          {% endif %}
        </span>
        <span class="text-nav-next">
          {% if next %}
          <a href="{{ next.url | url }}" class="text-nav-link">
            <span class="text-nav-label">{{ next.data.title }}</span>
            <span class="text-nav-arrow" aria-hidden="true">&rarr;</span>
          </a>
          {% endif %}
        </span>
      </nav>
      {% endif %}
    </div>
  </div>
</article>
