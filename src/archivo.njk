---
layout: layouts/base.njk
title: "Archivo"
description: "Archivo completo de textos."
permalink: /archivo/
---

<div class="archivo">
  <header class="archivo-header" data-pagefind-ignore>
    <div class="archivo-header-row">
      <h1 class="page-title">Archivo</h1>
      <p class="archivo-count">{{ collections.textos.length }} textos</p>
    </div>
    <div class="archivo-controls">
      <button type="button" class="text-button archive-sort is-active" data-sort-mode="recientes" data-sort-label="recientes" aria-sort="descending">recientes</button>
      <button type="button" class="text-button archive-sort" data-sort-mode="antiguos" data-sort-label="antiguos">antiguos</button>
      <button type="button" class="text-button archive-sort" data-sort-mode="az" data-sort-label="a-z">a-z</button>
    </div>
  </header>

  <div class="archivo-list" id="archivo-list">
    {% set currentYear = "" %}
    {% set currentMonth = "" %}
    {% for item in collections.textos %}
      {% set itemYear = item.date | yearOf %}
      {% set itemMonth = item.date | monthKey %}
      {% if itemYear != currentYear %}
        {% set currentYear = itemYear %}
        {% set currentMonth = "" %}
        <h2 class="archivo-year" data-year-heading="{{ itemYear }}">{{ itemYear }}</h2>
      {% endif %}
      {% if itemMonth != currentMonth %}
        {% set currentMonth = itemMonth %}
        <h3 class="archivo-month" data-month-heading="{{ itemMonth }}">{{ item.date | formatMonthLabel }}</h3>
      {% endif %}
      <div class="archivo-entry"
           data-date="{{ item.date | formatDateIso }}"
           data-title="{{ item.data.title | lower }}"
           data-year="{{ itemYear }}"
           data-month="{{ itemMonth }}">
        <div class="archivo-entry-meta">
          <span class="archivo-id">{{ item.data.id }}</span>
          <span class="archivo-sep" aria-hidden="true"> · </span>
          <time class="archivo-date" datetime="{{ item.date | formatDateIso }}">{{ item.date | formatDateShort }}</time>
        </div>
        <a class="archivo-title" href="{{ item.url | url }}">{{ item.data.title }}</a>
      </div>
    {% endfor %}
  </div>
</div>
