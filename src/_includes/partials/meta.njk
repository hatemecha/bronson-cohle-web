{% set explicitDescription = description | default(site.description) %}
{% set pageDescription = explicitDescription %}
{% if id and explicitDescription == site.description %}
  {% set pageDescription = content | bodyExcerpt(160) %}
{% endif %}
{% set canonicalUrl = page.url | absoluteUrl(site.url) %}
{% set publishedIso = none %}
{% if date %}
  {% set publishedIso = date | formatDateIso %}
{% endif %}
{% set imageData = none %}
{% if image %}
  {% set imageData = image | resolveTextoImage(page.fileSlug) %}
{% endif %}
{% if imageData %}
  {% set ogImageUrl = imageData.src | absoluteUrl(site.url) %}
  {% set ogImageType = "image/webp" %}
  {% set ogImageWidth = imageData.width or 1200 %}
  {% set ogImageHeight = imageData.height or 630 %}
  {% set twitterCard = "summary_large_image" %}
{% else %}
  {% set ogImageUrl = "/images/og.png" | absoluteUrl(site.url) %}
  {% set ogImageType = "image/png" %}
  {% set ogImageWidth = 1200 %}
  {% set ogImageHeight = 1200 %}
  {% set twitterCard = "summary" %}
{% endif %}

<title>{% if title and page.url != "/" %}{{ title }} — {% endif %}{{ site.name }}</title>
{% if noindex %}<meta name="robots" content="noindex">{% endif %}
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="{{ site.author }}">
<link rel="canonical" href="{{ canonicalUrl }}">
<link rel="icon" href="{{ '/favicon.png' | url }}" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="{{ '/apple-touch-icon.png' | url }}">
<meta name="theme-color" content="#08090a" media="(prefers-color-scheme: dark)">
<meta name="theme-color" content="#eef0f1" media="(prefers-color-scheme: light)">

<meta property="og:locale" content="es_AR">
<meta property="og:type" content="{% if id %}article{% else %}website{% endif %}">
<meta property="og:title" content="{% if title and page.url != "/" %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonicalUrl }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:image" content="{{ ogImageUrl }}">
<meta property="og:image:type" content="{{ ogImageType }}">
<meta property="og:image:width" content="{{ ogImageWidth }}">
<meta property="og:image:height" content="{{ ogImageHeight }}">
{% if id and publishedIso %}
<meta property="article:published_time" content="{{ publishedIso }}">
<meta property="article:author" content="{{ site.author }}">
{% endif %}
<meta name="twitter:card" content="{{ twitterCard }}">
<meta name="twitter:title" content="{% if title and page.url != "/" %}{{ title }}{% else %}{{ site.name }}{% endif %}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ ogImageUrl }}">

{% if id and publishedIso %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": pageDescription,
  "datePublished": publishedIso,
  "author": { "@type": "Person", "name": site.author },
  "mainEntityOfPage": { "@type": "WebPage", "@id": canonicalUrl },
  "image": ogImageUrl,
  "inLanguage": "es"
} | toJson | safe }}</script>
{% elif page.url == "/" %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": site.name,
  "url": site.url,
  "description": site.description,
  "inLanguage": "es",
  "author": { "@type": "Person", "name": site.author }
} | toJson | safe }}</script>
{% elif page.url == "/acerca/" %}
{% set acercaImage = "/images/acerca.webp" | absoluteUrl(site.url) %}
<script type="application/ld+json">{{ {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": site.author,
  "url": canonicalUrl,
  "image": acercaImage
} | toJson | safe }}</script>
{% endif %}
