<div class="a11y">
  <button
    id="reading-options"
    type="button"
    class="a11y-toggle text-button"
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Opciones de lectura"
  >Aa</button>
  <div class="a11y-panel" id="a11y-panel" hidden>
    <div class="a11y-group">
      <span class="a11y-label">Texto</span>
      <div class="a11y-options">
        <button type="button" class="text-button font-control" data-font="sm">A-</button>
        <button type="button" class="text-button font-control" data-font="base">A</button>
        <button type="button" class="text-button font-control" data-font="lg">A+</button>
        <button type="button" class="text-button font-control" data-font="xl">A++</button>
      </div>
    </div>
    <div class="a11y-group">
      <span class="a11y-label">Tema</span>
      <div class="a11y-options">
        <button type="button" class="text-button theme-control" data-theme="dark">Oscuro</button>
        <button type="button" class="text-button theme-control" data-theme="light">Claro</button>
      </div>
    </div>
    <div class="a11y-group a11y-group-full">
      <button type="button" class="text-button reading-control" aria-pressed="false">Modo lectura</button>
    </div>
  </div>
</div>
