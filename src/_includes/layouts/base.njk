<!DOCTYPE html>
<html lang="es" data-theme="dark" data-font-size="base" data-base-url="{{ '/' | url }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script>
    (function () {
      try {
        var theme = localStorage.getItem("bc-theme");
        if (theme === "light" || theme === "dark") {
          document.documentElement.setAttribute("data-theme", theme);
        }
        var size = localStorage.getItem("bc-font-size");
        if (size === "sm" || size === "base" || size === "lg" || size === "xl") {
          document.documentElement.setAttribute("data-font-size", size);
        }
        var reading = localStorage.getItem("bc-reading");
        if (reading === "on") {
          document.documentElement.setAttribute("data-reading", "on");
        }
      } catch (e) {}
    })();
  </script>
  {% include "partials/meta.njk" %}
  <link rel="preload" href="{{ '/fonts/source-serif-4-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/fonts/ibm-plex-mono-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="{{ '/css/main.css' | url }}">
  <link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ '/feed.xml' | url }}">
</head>
<body>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  {% include "partials/header.njk" %}
  <main id="contenido" class="main">
    <div class="site-shell">
      {{ content | safe }}
    </div>
  </main>
  {% include "partials/footer.njk" %}
  <script src="{{ '/js/main.js' | url }}" defer></script>
</body>
</html>
