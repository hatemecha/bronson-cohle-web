# Compatible con .gitattributes: ambos declaran LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Los textos son prosa: no indentar, no recortar espacios internos.
indent_style = unset
trim_trailing_whitespace = false

[*.{webp,png,jpg,jpeg,gif,ico}]
insert_final_newline = unset
trim_trailing_whitespace = unset
