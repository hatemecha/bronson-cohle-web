<div class="reading-controls" aria-label="Preferencias de lectura">
  <span class="controls-group">
    <button type="button" class="text-button font-control" data-font="sm" aria-label="Texto más pequeño">A−</button>
    <button type="button" class="text-button font-control" data-font="base" aria-label="Texto normal">A</button>
    <button type="button" class="text-button font-control" data-font="lg" aria-label="Texto más grande">A+</button>
  </span>
  <button type="button" class="text-button theme-control" aria-label="Cambiar tema claro u oscuro">
    <span data-theme-label>Claro / Oscuro</span>
  </button>
</div>
