---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.name | xmlEscape }}</title>
    <link>{{ site.url }}/</link>
    <atom:link href="{{ '/feed.xml' | absoluteUrl(site.url) }}" rel="self" type="application/rss+xml"/>
    <description>{{ site.description | xmlEscape }}</description>
    <language>es</language>
    {% if collections.textos[0] %}
    <lastBuildDate>{{ collections.textos[0] | publishedDate | formatDateRfc822 }}</lastBuildDate>
    {% endif %}
    {% for item in collections.textos %}
    <item>
      <title>{{ item.data.title | xmlEscape }}</title>
      <link>{{ item.url | absoluteUrl(site.url) }}</link>
      <guid isPermaLink="true">{{ item.url | absoluteUrl(site.url) }}</guid>
      <pubDate>{{ item | publishedDate | formatDateRfc822 }}</pubDate>
      <description>{{ item.templateContent | bodyExcerpt(300) | xmlEscape }}</description>
    </item>
    {% endfor %}
  </channel>
</rss>
