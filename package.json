{
  "name": "bronson-cohle-web",
  "version": "0.1.5",
  "private": true,
  "description": "Sitio estático de textos personales.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "hatemecha",
  "repository": {
    "type": "git",
    "url": "https://github.com/hatemecha/bronson-cohle-web.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "eleventy && npx pagefind --site dist",
    "validate": "node scripts/validate-content.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "verify": "node scripts/verify-build.mjs",
    "check": "npm run validate && npm run build && npm run verify",
    "dev": "eleventy --serve",
    "start": "npm run dev"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "pagefind": "^1.3.0",
    "sharp": "^0.35.4"
  }
}
